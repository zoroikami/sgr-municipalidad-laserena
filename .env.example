# Copy to .env (ignored). Replace secrets privately. Production uses DEBUG=false.
DJANGO_SECRET_KEY=replace-with-a-private-random-value-at-least-50-characters-long
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
DB_NAME=sgr_django
DB_USER=sgr
DB_PASSWORD=replace-with-a-private-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-private-database-password
DB_HOST=127.0.0.1
DB_PORT=3307
REDIS_URL=redis://127.0.0.1:6380/0
# Local mail inbox: docker compose up -d mailpit; http://127.0.0.1:8025
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=SGR <sgr@example.test>
# Local HTTP only: DEBUG=true makes cookies/redirects suitable for local use.
# Production HTTPS: set public hosts and origins and keep the following true.
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
TRUST_PROXY_SSL=false
APP_COMMIT=local
# Optional real mailbox for the review; never commit its credentials.
# DEMO_EMAIL_ADMIN_A=review-address@example.test
