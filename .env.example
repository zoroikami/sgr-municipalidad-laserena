DJANGO_DEBUG=true
# En producción: clave aleatoria, DEBUG=false, hosts y orígenes HTTPS explícitos.
# Generar una clave distinta en cada instalación y guardarla solo en .env.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Desarrollo: los correos aparecen en la consola. Para enviar, usar backend SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
