@startuml CU-07_actualizar_estado_compromiso
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
left to right direction

title Caso de Uso Específico: CU-07: Actualizar Estado de Compromiso en Tubo de Trabajo\nSistema SGR - Municipalidad de La Serena

actor "Funcionario / Delegado" as ACT_PRIMARY #e0f2fe
actor "Sistema de Notificaciones SGR" as ACT_SYS #f1f5f9

rectangle "Sistema de Gestión de Resultados (SGR)" {
    usecase "Actualizar Estado de Compromiso" as UC_BASE #dbeafe
    usecase "Mover Tarjeta en Tablero Kanban" as INC_1 #f8fafc
    usecase "Registrar Historial de Transición" as INC_2 #f8fafc
    usecase "Notificar Compromiso Vencido" as EXT_1 #fff1f2
    usecase "Reasignar por Licencia o Ausencia" as EXT_2 #fff1f2

    ' Relaciones de Inclusión
    UC_BASE ..> INC_1 : <<include>>
    UC_BASE ..> INC_2 : <<include>>

    ' Relaciones de Extensión
    EXT_1 ..> UC_BASE : <<extend>>\n(Condición: Fecha límite sobrepasada)
    EXT_2 ..> UC_BASE : <<extend>>\n(Condición: Funcionario titular con licencia médica)
}

ACT_PRIMARY --> UC_BASE
UC_BASE --> ACT_SYS

@enduml