@startuml CU-05_registrar_atencion_social_multietapa
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
left to right direction

title Caso de Uso Específico: CU-05: Registrar Atención Social Multietapa (Hasta 3 Gestiones)\nSistema SGR - Municipalidad de La Serena

actor "Gestor Social" as ACT_PRIMARY #e0f2fe
actor "Módulo de Personas Usuarias" as ACT_SYS #f1f5f9

rectangle "Sistema de Gestión de Resultados (SGR)" {
    usecase "Registrar Atención Social" as UC_BASE #dbeafe
    usecase "Buscar Ficha de Beneficiario" as INC_1 #f8fafc
    usecase "Registrar Nueva Gestión Social" as INC_2 #f8fafc
    usecase "Crear Ficha de Nueva Persona" as EXT_1 #fff1f2
    usecase "Bloquear Cuarta Gestión (Tope Período)" as EXT_2 #fff1f2

    ' Relaciones de Inclusión
    UC_BASE ..> INC_1 : <<include>>
    UC_BASE ..> INC_2 : <<include>>

    ' Relaciones de Extensión
    EXT_1 ..> UC_BASE : <<extend>>\n(Condición: RUT no existe en el sistema)
    EXT_2 ..> UC_BASE : <<extend>>\n(Condición: Persona ya posee 3 gestiones registradas)
}

ACT_PRIMARY --> UC_BASE
UC_BASE --> ACT_SYS

@enduml