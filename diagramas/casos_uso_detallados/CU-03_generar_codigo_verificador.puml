@startuml CU-03_generar_codigo_verificador
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
left to right direction

title Caso de Uso Específico: CU-03: Generar Código Único de Evidencia (EVI-2026-XXXX)\nSistema SGR - Municipalidad de La Serena

actor "Sistema SGR" as ACT_PRIMARY #e0f2fe
actor "Mecanismo de Persistencia MySQL" as ACT_SYS #f1f5f9

rectangle "Sistema de Gestión de Resultados (SGR)" {
    usecase "Generar Código Correlativo EVI" as UC_BASE #dbeafe
    usecase "Obtener Correlativo de Período" as INC_1 #f8fafc
    usecase "Formatear Clave Alfanumérica" as INC_2 #f8fafc
    usecase "Gestionar Error de Concurrencia" as EXT_1 #fff1f2

    ' Relaciones de Inclusión
    UC_BASE ..> INC_1 : <<include>>
    UC_BASE ..> INC_2 : <<include>>

    ' Relaciones de Extensión
    EXT_1 ..> UC_BASE : <<extend>>\n(Condición: Colisión simultánea de correlativo)
}

ACT_PRIMARY --> UC_BASE
UC_BASE --> ACT_SYS

@enduml