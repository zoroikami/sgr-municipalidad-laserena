@startuml CU-01_autenticacion_acceso
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
left to right direction

title Caso de Uso Específico: CU-01: Autenticación de Usuario y Control de Acceso\nSistema SGR - Municipalidad de La Serena

actor "Funcionario Municipal" as ACT_PRIMARY #e0f2fe
actor "Servidor de Identidad" as ACT_SYS #f1f5f9

rectangle "Sistema de Gestión de Resultados (SGR)" {
    usecase "Autenticar Usuario" as UC_BASE #dbeafe
    usecase "Validar Credenciales" as INC_1 #f8fafc
    usecase "Verificar Estado de Cuenta" as INC_2 #f8fafc
    usecase "Notificar Credenciales Inválidas" as EXT_1 #fff1f2
    usecase "Bloquear Acceso por Inactividad" as EXT_2 #fff1f2

    ' Relaciones de Inclusión
    UC_BASE ..> INC_1 : <<include>>
    UC_BASE ..> INC_2 : <<include>>

    ' Relaciones de Extensión
    EXT_1 ..> UC_BASE : <<extend>>\n(Condición: Credenciales no coinciden)
    EXT_2 ..> UC_BASE : <<extend>>\n(Condición: Sesión expirada tras 15 min)
}

ACT_PRIMARY --> UC_BASE
UC_BASE --> ACT_SYS

@enduml