@startuml CU-09_consultar_tablero_delegacion
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
left to right direction

title Caso de Uso Específico: CU-09: Consultar Tablero Consolidado de Delegación\nSistema SGR - Municipalidad de La Serena

actor "Delegado Municipal" as ACT_PRIMARY #e0f2fe
actor "Servicio de Reportería y Gráficos" as ACT_SYS #f1f5f9

rectangle "Sistema de Gestión de Resultados (SGR)" {
    usecase "Consultar Tablero de Delegación" as UC_BASE #dbeafe
    usecase "Consolidar Semáforos de Equipo" as INC_1 #f8fafc
    usecase "Calcular Promedio Ponderado Grupal" as INC_2 #f8fafc
    usecase "Renderizar Gráficos Comparativos" as EXT_1 #fff1f2
    usecase "Búsqueda Omnibox sin Coincidencias" as EXT_2 #fff1f2

    ' Relaciones de Inclusión
    UC_BASE ..> INC_1 : <<include>>
    UC_BASE ..> INC_2 : <<include>>

    ' Relaciones de Extensión
    EXT_1 ..> UC_BASE : <<extend>>\n(Condición: Delegado activa vista estadística)
    EXT_2 ..> UC_BASE : <<extend>>\n(Condición: Criterio de búsqueda no arroja datos)
}

ACT_PRIMARY --> UC_BASE
UC_BASE --> ACT_SYS

@enduml