@startuml CU-10_configurar_metas_ponderadores_periodo
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
left to right direction

title Caso de Uso Específico: CU-10: Configurar Período de Medición y Ponderadores al 100%\nSistema SGR - Municipalidad de La Serena

actor "Administrador Central" as ACT_PRIMARY #e0f2fe
actor "Validador de Reglas de Negocio" as ACT_SYS #f1f5f9

rectangle "Sistema de Gestión de Resultados (SGR)" {
    usecase "Configurar Metas y Ponderadores" as UC_BASE #dbeafe
    usecase "Definir Fechas de Período" as INC_1 #f8fafc
    usecase "Validar Suma de Ponderadores" as INC_2 #f8fafc
    usecase "Rechazar Configuración por Suma Distinta a 100%" as EXT_1 #fff1f2

    ' Relaciones de Inclusión
    UC_BASE ..> INC_1 : <<include>>
    UC_BASE ..> INC_2 : <<include>>

    ' Relaciones de Extensión
    EXT_1 ..> UC_BASE : <<extend>>\n(Condición: Ponderadores suman <> 100%)
}

ACT_PRIMARY --> UC_BASE
UC_BASE --> ACT_SYS

@enduml